FROM python:3.12-slim

WORKDIR /app
COPY app.py .

EXPOSE 8000
# The same shell form with the `exec` left out, which is the shape the note was
# written for: the shell stays as PID 1 with a default SIGTERM disposition, the
# kernel discards the signal, and the application never hears about it. The
# handler the application would have installed is irrelevant — it is a child.
ENV HANDLE_SIGTERM=1
CMD ["/bin/sh", "-c", "python -u app.py"]
