FROM python:3.12-slim

WORKDIR /app
COPY app.py .

EXPOSE 8000
# The point of this image. Kubernetes always sends SIGTERM and ignores
# STOPSIGNAL, so an image that declares anything else behaves one way under
# `docker stop` and another way in a cluster. preflightkit sends SIGTERM
# explicitly for exactly this reason — the declaration is a static finding, not
# something that changes what we measure.
STOPSIGNAL SIGQUIT
CMD ["python", "-u", "app.py"]
